quadratic_fn <- function (a, b, c) {
delta <- b^2 - 4 * a * c
if (delta < 0)
print(paste("X is a complex number"))
else if (delta == 0)
result <- -b / (2 * a)
else
result <- c(-b - sqrt(delta) / (2 * a), -b + sqrt(delta) / (2 * a))
return(result)
}
